{
  "name": "unmasked",
  "version": "0.1.0",
  "private": true,
  "description": "Unmasked: the psychology of the human body. Website (client/) and Express + PostgreSQL API (server/).",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "npm --prefix client run build",
    "site": "node scripts/run.mjs site",
    "site:open": "node scripts/run.mjs site --open",
    "db:reset": "npm --prefix server run db:reset",
    "db:seed:build": "npm --prefix server run db:seed:build",
    "test": "npm --prefix server test",
    "deploy:pages": "node scripts/deploy-pages.mjs"
  }
}
