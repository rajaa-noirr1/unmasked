# Copy this file to server/.env and fill in the two passwords. server/.env is never committed.
# POSTGRES_PASSWORD: the PostgreSQL superuser's password (user postgres), set when PostgreSQL was
# installed. Only npm run db:reset uses it, to create the website's own database user and database.
POSTGRES_PASSWORD=

# The website's own database user and database (db:reset creates them with these values)
PGHOST=localhost
PGPORT=5432
PGDATABASE=unmasked
PGUSER=unmasked_app
PGPASSWORD=

# The API server's port (OREN uses 4000, so this one uses 4100)
API_PORT=4100
